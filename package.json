{
    "name": "internetdata-cloudflare",
    "private": true,
    "version": "1.1.2",
    "description": "Forward each visitor's IP data to your site from Cloudflare's edge, on any plan, and block or challenge by country, network and privacy signals with the InternetData API.",
    "type": "module",
    "license": "MIT",
    "homepage": "https://internetdata.io",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/internetdata/cloudflare-plugin.git"
    },
    "scripts": {
        "build": "wrangler deploy --dry-run --outdir dist",
        "deploy": "wrangler deploy",
        "dev": "wrangler dev",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && node --test test/*.test.mjs"
    },
    "cloudflare": {
        "bindings": {
            "INTERNETDATA_API_KEY": {
                "description": "Your InternetData API key. Create one for free in the [console](https://app.internetdata.io)."
            }
        }
    },
    "dependencies": {
        "@internetdata/internetdata": "^2.19.0",
        "ip-address": "^10.7.6",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20261114.1",
        "@mslmio/eslint-config": "^2.6.1",
        "eslint": "^10.15.0",
        "miniflare": "5.20261116.0-beta",
        "typescript": "^6.0.3",
        "wrangler": "^4.163.0"
    }
}
